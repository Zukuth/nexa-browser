{
  "name": "chilean-browser",
  "version": "0.2.3",
  "description": "Navegador de escritorio multi-cuenta: abre varias sesiones aisladas del mismo sitio en una sola ventana.",
  "main": "electron/main.js",
  "author": "Nexa Browser",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexabrowser.app",
    "productName": "Nexa Browser",
    "icon": "electron/assets/icon.png",
    "compression": "normal",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "publisherName": "Nexa Browser",
      "artifactName": "${productName}-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexa Browser"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "maintainer": "Nexa Browser",
      "artifactName": "${productName}-${version}-x64.${ext}"
    },
    "directories": {
      "output": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "Zukuth",
      "repo": "nexa-browser",
      "releaseType": "release"
    }
  }
}
