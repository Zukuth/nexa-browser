{
  "name": "nexa-browser",
  "version": "0.4.1",
  "description": "Navegador de escritorio multi-cuenta: abre varias sesiones aisladas del mismo sitio en una sola ventana.",
  "main": "electron/main.js",
  "author": "Nexa Browser",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "node scripts/start.js",
    "start:electron": "electron .",
    "dist": "electron-builder",
    "test": "node --experimental-test-module-mocks --test test/unit/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html --exclude=test/** --exclude=scripts/** npm test",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:e2e": "playwright test --workers=1",
    "test:smoke": "playwright test test/e2e/live-health.spec.js",
    "test:soak": "node scripts/soak.js",
    "verify:translate-dynamic": "node scripts/verify-translate-dynamic.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "src/i18n-data.js": [
      "node scripts/check-i18n.js"
    ]
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "franc-min": "^6.2.0",
    "yauzl": "^2.10.0"
  },
  "optionalDependencies": {
    "adblock-rs": "^0.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "c8": "^12.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "com.nexabrowser.app",
    "productName": "Nexa Browser",
    "icon": "electron/assets/icon.png",
    "compression": "normal",
    "files": [
      "electron/**/*",
      "src/**/*",
      "!**/node_modules/adblock-rs/target/**/*",
      "!**/node_modules/adblock-rs/js/example.mjs",
      "!**/node_modules/adblock-rs/js/test/**/*",
      "!**/node_modules/adblock-rs/data/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/adblock-rs/js/index.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Nexa Browser"
      },
      "artifactName": "Nexa-Browser-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexa Browser"
    },
    "directories": {
      "output": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "Zukuth",
      "repo": "nexa-browser",
      "releaseType": "release"
    }
  }
}
