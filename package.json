{
  "name": "nexa-browser",
  "version": "0.3.4",
  "description": "Navegador de escritorio multi-cuenta: abre varias sesiones aisladas del mismo sitio en una sola ventana.",
  "main": "electron/main.js",
  "author": "Nexa Browser",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "start:electron": "electron .",
    "dist": "electron-builder",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test test/e2e/live-health.spec.js",
    "test:soak": "node scripts/soak.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^43.0.0",
    "electron-builder": "^24.13.3",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "com.nexabrowser.app",
    "productName": "Nexa Browser",
    "icon": "electron/assets/icon.png",
    "compression": "normal",
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Nexa Browser",
      "artifactName": "Nexa-Browser-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexa Browser"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Nexa Browser",
      "artifactName": "Nexa-Browser-${version}-x64.${ext}"
    },
    "directories": {
      "output": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "Zukuth",
      "repo": "nexa-browser",
      "releaseType": "release"
    }
  }
}
