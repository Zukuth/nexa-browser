<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only needed pre-scoped-storage; DownloadManager writes to Downloads/
         without it on API 29+. maxSdkVersion keeps it off newer installs. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".NexaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Nexa Browser"
        android:theme="@style/Theme.NexaBrowser">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PasswordsActivity"
            android:exported="false"
            android:label="Contraseñas" />

        <!--
          Fase 2: pool fijo de 4 slots de proceso. Las cuatro comparten el
          100% de su código (todas extienden WebViewSlotActivity), pero cada
          una vive en su propio proceso Android — así que hasta 4 cuentas
          pueden estar realmente aisladas (cookies, storage) al mismo tiempo.
          AccountSlotManager decide qué cuenta va en qué slot y expulsa por
          LRU cuando hace falta un quinto.
        -->
        <activity
            android:name=".slots.SlotActivity0"
            android:process=":wv0"
            android:exported="false"
            android:label="Nexa Browser"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".slots.SlotActivity1"
            android:process=":wv1"
            android:exported="false"
            android:label="Nexa Browser"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".slots.SlotActivity2"
            android:process=":wv2"
            android:exported="false"
            android:label="Nexa Browser"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".slots.SlotActivity3"
            android:process=":wv3"
            android:exported="false"
            android:label="Nexa Browser"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>

</manifest>
