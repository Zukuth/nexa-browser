<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nexa Browser — Fase 0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prueba de aislamiento multi-proceso: cada slot corre en su propio proceso Android (:wv0 / :wv1) y llama setDataDirectorySuffix() antes de crear su WebView."
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSlot0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrir Slot 0 (proceso :wv0)"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSlot1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrir Slot 1 (proceso :wv1)"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fase 1"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrir navegador" />

</LinearLayout>
