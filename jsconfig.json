{
  "compilerOptions": {
    "checkJs": false,
    "allowJs": true,
    "noImplicitAny": false,
    "target": "ES2023",
    "module": "commonjs",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["electron/**/*.js", "src/**/*.js", "scripts/**/*.js"],
  "exclude": ["node_modules", "build", "test-results", "playwright-report"]
}
